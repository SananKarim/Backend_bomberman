# Server environment — copy to .env (never commit real secrets; this app has none).
# The Node process reads these from the environment directly (no dotenv needed
# locally: `PORT=3000 ALLOWED_ORIGINS=... npm start`, or set them in your shell).

# HTTP/Socket.IO port. Cloud Run ALWAYS injects PORT — the app must bind it.
PORT=3000

# Comma-separated list of browser origins allowed to open sockets.
# Dev examples: local static server and a phone using the computer LAN IP.
# Production: GitHub Pages origin only (path is not part of an origin).
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://192.168.18.115:5000,https://sanankarim.github.io

# Development convenience: serve ../public from this server so one command runs
# the whole game locally (http://127.0.0.1:3000). Leave unset in production —
# Firebase Hosting serves the frontend there.
SERVE_PUBLIC=

# Fixed server simulation tick rate for authoritative matches (ms).
SIM_TICK_MS=50

# Snapshot broadcast rate per room (ms). Kept below the tick only if raised.
BROADCAST_MS=100
