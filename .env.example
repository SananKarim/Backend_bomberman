# Set these in Render > Environment. The server reads environment variables,
# not .env files. Render supplies PORT automatically; locally it defaults to 3000.
PORT=3000

# Exact browser origins only: HTTPS Vercel domain, no path or trailing slash.
# Add localhost/LAN origins only for local testing. Do not use * in production.
ALLOWED_ORIGINS=https://YOUR_FRONTEND.vercel.app

# Local convenience only: serve the sibling frontend/ folder on port 3000.
# Leave unset on Render; Vercel serves the frontend separately.
SERVE_PUBLIC=

SIM_TICK_MS=50
BROADCAST_MS=100
